# Private Google OAuth web client. No account data belongs in this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://your-domain.example/api/calendar/callback
GOOGLE_REDIRECT_URI=
# 32 random bytes encoded as 64 hex characters; keep this key stable.
CALENDAR_ENCRYPTION_KEY=

# Private photo album (configure separately for each deployment)
BLOB_STORE_ID=
# Alternatively, when the store is connected with a read/write token:
BLOB_READ_WRITE_TOKEN=
PHOTO_ADMIN_KEY=
PHOTO_DISPLAY_KEY=

# Optional outfit advice. Vercel deployments authenticate to AI Gateway using OIDC.
# For local development only, set AI_GATEWAY_API_KEY securely.
AI_GATEWAY_API_KEY=
# Model verified in the Gateway catalog on 2026-10-22; pricing/eligibility can change.
OUTFIT_AI_MODEL=nvidia/nemotron-3.5-lightning-free
# Set false to use weather rules without any model requests.
OUTFIT_AI_ENABLED=true
